# {{ ansible_managed }}
# The peer broker: passes text between linked sessions, and nothing else. A
# system unit, so that its code and policy stay root-owned while it runs as
# {{ sandbox_user }}; messages go to the journal. See docs/design.md,
# "Sessions that talk to each other".
[Unit]
Description=agentbox peer broker

[Service]
Type=simple
User={{ sandbox_user }}
Group={{ sandbox_user }}
ExecStart=/usr/bin/python3 {{ agentbox_peer_broker_path }} {{ agentbox_peer_links_path }}
Restart=on-failure
RuntimeDirectory={{ agentbox_peer_run_dir | basename }}
RuntimeDirectoryMode=0700
UMask=0077
# It needs its sockets and nothing else.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service
MemoryMax=64M
TasksMax=16

[Install]
WantedBy=multi-user.target

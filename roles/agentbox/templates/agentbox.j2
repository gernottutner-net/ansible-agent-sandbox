#!/bin/sh
# {{ ansible_managed }}
# The only supported way to start a sandbox session:
#
#   agentbox [--tmux] [--editor|--no-editor] <project> [command ...]
#   agentbox [--tmux] [--editor|--no-editor] --auto <project> [claude-args ...]
#   agentbox --list
#
# Runs {{ _agentbox_image }} with <project> from {{ _agentbox_projects_dir }}
# mounted at /work, and the command (default: claude) inside it. With --auto,
# Claude Code runs with --dangerously-skip-permissions: no prompts at all,
# with the container, Squid and Claude Code's strict sandbox as the boundary,
# and without the claude.ai connectors.
# Claude Code's login and settings for the project persist in
# {{ _agentbox_state_dir }}/<project>, outside /work so they never end up in the
# project's repository; its managed settings come read-only from
# {{ agentbox_managed_settings_path }}. The run policy is fixed here, not taken
# from the environment or the command line, so no session can forget a limit.
# Repository tokens the git_token playbook wrote for <project> are mounted
# read-only; a session token is deleted when the session ends.
# With --tmux, the session runs inside the tmux session agentbox-<project>,
# which outlives the connection; the same command attaches to it later.
# --list shows the projects and which of them run.
{% if _agentbox_editor_on %}
# The editor: VS Code Server for the browser in agentbox-<project>-editor, a
# container beside the session on the same /work, with limits of its own
# and none of the session's credentials: no repository tokens, no API key,
# no Claude Code state. Started {{ 'by default' if agentbox_editor | bool else 'with --editor' }} for a session on
# a terminal that is not a -p run; stopped when the session ends. It listens
# on a socket in {{ agentbox_editor_run_dir }}/<project>, which the
# controller reaches through ssh -L: agentbox-remote --open-editor <project>.
{% endif %}
{% if agentbox_peer_links %}
# A plain interactive session in a project with a link is linked: it gets its
# socket to the peer broker, and Claude Code's channels, which need telemetry
# on. --auto, a -p run or any other command is not, and stays as it is.
{% endif %}
# See README.md, "The launcher" and "Sessions that outlive the connection",
# and docs/design.md, "The launcher contract" and "Repository tokens".
set -eu

die() {
    echo "agentbox: $*" >&2
    exit 1
}

[ "$(id -un)" = {{ sandbox_user | quote }} ] \
    || die "run as {{ sandbox_user }}, e.g. sudo -iu {{ sandbox_user }} agentbox <project>"

usage="usage: agentbox [--tmux] [--editor|--no-editor] [--auto] <project> [args ...] | agentbox --list"

# One directory by name: no slashes, no dot-names, nothing that could reach
# outside the projects directory.
check_name() {
    case $1 in
        [A-Za-z0-9]*) ;;
        *) die "project name must start with a letter or digit: $1" ;;
    esac
    case $1 in
        *[!A-Za-z0-9._-]*) die "project name may contain only letters, digits, '.', '_' and '-': $1" ;;
    esac
}

# sudo -i does not set it, and rootless Podman finds the user's systemd
# instance through it.
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR

# The tmux session of a project. tmux turns '.' in a session name into '_',
# which would make my.app and my_app one session; '+' is in no project name.
tmux_session() {
    printf 'agentbox-%s' "$(printf '%s' "$1" | tr . +)"
}

# The projects, and which of them have a session: "running" for the
# container, "tmux" for a tmux session.
if [ "${1:-}" = --list ]; then
    [ $# -eq 1 ] || die "$usage"
    for dir in {{ _agentbox_projects_dir | quote }}/*/; do
        [ -d "$dir" ] || continue
        name=${dir%/}
        name=${name##*/}
        state=
        if podman container exists "agentbox-$name"; then state=running; fi
{% if _agentbox_editor_on %}
        if podman container exists "agentbox-$name-editor"; then state="${state:+$state }editor"; fi
{% endif %}
        if tmux has-session -t "=$(tmux_session "$name")" 2>/dev/null; then state="${state:+$state }tmux"; fi
        printf '%s%s\n' "$name" "${state:+  $state}"
    done
    exit 0
fi

# A session that outlives the connection: this launcher again, inside the
# project's tmux session (agentbox-<project>, '.' as '+'), or an attach to
# it if it is there. A dropped connection hangs up only the tmux client; the
# launcher in the pane keeps running. tmux kill-session hangs up the pane,
# and the launcher stops the container as for a lost terminal. The tmux
# server starts in a scope of the sandbox user's own systemd instance, which
# lingers, not in the login session of whoever ran sudo, so a logout does
# not take it along.
# The options, in any order, before the project.
tmux=
auto=
editor_opt=
while [ $# -gt 0 ]; do
    case $1 in
        --tmux) tmux=1 ;;
        --auto) auto=1 ;;
{% if _agentbox_editor_on %}
        --editor | --no-editor) editor_opt=$1 ;;
{% else %}
        --no-editor) ;;
        --editor) die "the editor is not installed; see agentbox_editor_accept_server_license" ;;
{% endif %}
        -*) die "$usage" ;;
        *) break ;;
    esac
    shift
done

if [ -n "$tmux" ]; then
    [ $# -ge 1 ] || die "$usage"
    project=$1
    shift
    check_name "$project"
    [ -t 0 ] && [ -t 1 ] || die "--tmux needs a terminal; over SSH, use ssh -t"
    session=$(tmux_session "$project")
    if tmux has-session -t "=$session" 2>/dev/null; then
        [ -z "$auto$editor_opt" ] && [ $# -eq 0 ] \
            || die "a session in $project is running already; attach with agentbox --tmux $project"
        exec tmux attach-session -t "=$session"
    fi
    # Checked before tmux starts: the launcher in the pane would refuse it
    # too, but the pane would close before anyone read why.
    if podman container exists "agentbox-$project"; then
        die "a session in $project is running already (container agentbox-$project), outside tmux"
    fi
    exec systemd-run --user --scope --quiet --collect -- \
        tmux new-session -s "$session" -- \
        {{ agentbox_launcher_path | quote }} ${editor_opt:+"$editor_opt"} ${auto:+--auto} "$project" "$@"
fi

[ $# -ge 1 ] || die "$usage"
project=$1
shift

{% if agentbox_peer_links %}
# Before --auto rewrites the arguments: a linked session is claude with no
# arguments, on a terminal, without --auto.
linked=
unlinked=1
peers=
if [ -z "$auto" ] && [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then
    case $project in
{%   for name in _agentbox_peer_projects %}
        {{ name | quote }}) linked=1; unlinked=; peers={{ agentbox_peer_links | selectattr('from', 'eq', name) | map(attribute='to') | unique | sort | join(' ') | quote }} ;;
{%   endfor %}
    esac
fi

{% endif %}
{% if _agentbox_editor_on %}
# Whether this session gets an editor: as the option says; without one,
{% if agentbox_editor | bool %}
# for a session on a terminal that is not a -p run. Checked before --auto
# turns the arguments into claude's.
{% else %}
# none (agentbox_editor is false).
{% endif %}
editor=
case $editor_opt in
    --editor) editor=1 ;;
    --no-editor) ;;
{% if agentbox_editor | bool %}
    *)
        if [ -t 0 ] && [ -t 1 ]; then
            editor=1
            for arg; do
                case $arg in -p | --print) editor= ;; esac
            done
        fi
        ;;
{% endif %}
esac

{% endif %}
# Autonomous: Claude Code without permission prompts. Extra arguments go to
# claude, e.g. agentbox --auto <project> -p "<task>" for an unattended run.
if [ -n "$auto" ]; then
    set -- claude --dangerously-skip-permissions "$@"
fi

check_name "$project"

podman image exists {{ _agentbox_image | quote }} \
    || die "image {{ _agentbox_image }} is missing; run the sandbox playbook with --tags agentbox"

[ -r {{ agentbox_managed_settings_path | quote }} ] \
    || die "Claude Code policy {{ agentbox_managed_settings_path }} is missing; run the sandbox playbook with --tags agentbox"

# Optional: without the secret, Claude Code uses the login kept in the state
# directory.
if podman secret exists {{ agentbox_api_key_secret | quote }}; then
    secret=--secret={{ agentbox_api_key_secret }},type=env,target=ANTHROPIC_API_KEY
else
    secret=
fi

# Checked here, although podman refuses the name too: by then a session
# token would already be taken from the session that is running.
if podman container exists "agentbox-$project"; then
    die "a session in $project is running already (container agentbox-$project)"
fi

workdir={{ _agentbox_projects_dir | quote }}/$project
statedir={{ _agentbox_state_dir | quote }}/$project
mkdir -p "$workdir"
mkdir -p -m 0700 "$statedir"

# Repository tokens, one file per host, answered by git-credential-agentbox in
# the image. A permanent token stays; a session token is taken for this run,
# renamed so that one written meanwhile waits for the next session, and
# deleted when the container exits, on a signal too. tmpfs, so a reboot
# clears it as well. Named here by host and lifetime, never by value.
permdir={{ _agentbox_token_dir | quote }}/$project
sessdir={{ _agentbox_session_token_dir | quote }}/$project
rundir=

# A lost terminal ends the session. SIGHUP from a dropped SSH connection
# kills podman's client, but not the container, which conmon keeps running
# (seen 2026-11-02): it would sit there, holding the project's name, until
# stopped by hand. So a signal stops it; the trap runs once podman's client
# has returned. The session token goes on exit, whatever the cause. Output to
# /dev/null and every command allowed to fail: the terminal may be gone, and
# under set -e a failed write would end the trap before the stop.
{% if _agentbox_editor_on %}
editor_started=
editor_name=agentbox-$project-editor
editor_sockdir={{ agentbox_editor_run_dir | quote }}/$project
editor_token=$XDG_RUNTIME_DIR/agentbox/editor/$project.token
{% endif %}
cleanup() {
{% if _agentbox_editor_on %}
    # The editor goes with the session, its socket and token with it: the
    # socket file outlives the container, and would block the next start.
    if [ -n "$editor_started" ]; then
        podman stop --ignore --time 5 "$editor_name" >/dev/null 2>&1 || :
        rm -rf "$editor_sockdir" "$editor_token" || :
    fi
{% endif %}
    if [ -n "$rundir" ]; then rm -rf "$rundir"; fi
}
on_signal() {
    podman stop --ignore --time 10 "agentbox-$project" >/dev/null 2>&1 || :
    exit "$1"
}
trap cleanup EXIT
trap 'on_signal 129' HUP
trap 'on_signal 130' INT
trap 'on_signal 143' TERM

{% if _agentbox_editor_on %}
# The editor, started before the session so that the session's terminal is
# not shared with its output. A failure costs the editor, not the session.
if [ -n "$editor" ]; then
    # Left over by a launcher that could not clean up: the session is not
    # running (checked above), so neither should its editor be.
    podman rm --force --ignore --time 5 "$editor_name" >/dev/null 2>&1 || :

    # Fresh each start: the old socket goes with the directory. It inherits
    # group {{ agentbox_editor_group }} and setgid from {{ agentbox_editor_run_dir }}; this
    # user is not in that group, so a chmod would clear setgid: umask only.
    rm -rf "$editor_sockdir"
    (umask 007 && mkdir "$editor_sockdir")

    # A fresh connection token per session, readable by this user only.
    mkdir -p -m 0700 "${editor_token%/*}"
    (umask 077 && od -An -tx1 -N24 /dev/urandom | tr -d ' \n' >"$editor_token")

    # The editor's settings and state, kept per project. The machine settings
    # are mounted read-only over the empty file; uploads the server refused
    # are kept in CachedExtensionVSIXs, emptied here.
    editor_state={{ _agentbox_editor_state_dir | quote }}/$project
    mkdir -p -m 0700 "$editor_state"
    mkdir -p "$editor_state/data/Machine"
    [ -e "$editor_state/data/Machine/settings.json" ] || : >"$editor_state/data/Machine/settings.json"
    rm -rf "$editor_state/data/CachedExtensionVSIXs"

    editor_started=1
    if podman image exists {{ _agentbox_editor_image | quote }} \
        && podman run --detach --rm \
            --name "$editor_name" \
            --init \
            --pull=never \
            --memory={{ agentbox_editor_memory | quote }} --memory-swap={{ agentbox_editor_memory | quote }} \
            --cpus={{ agentbox_editor_cpus | quote }} \
            --pids-limit={{ agentbox_editor_pids_limit | quote }} \
            --cap-drop=ALL \
            --security-opt=no-new-privileges \
            --userns=keep-id:uid={{ agentbox_image_uid }},gid={{ agentbox_image_uid }} \
            --volume "$workdir:/work" --workdir /work \
            --volume "$editor_state:{{ _agentbox_editor_data }}" \
            --volume {{ (agentbox_editor_machine_settings_path ~ ':' ~ _agentbox_editor_data ~ '/data/Machine/settings.json:ro') | quote }} \
            --volume "$editor_sockdir:/run/agentbox/editor" \
            --volume "$editor_token:/run/agentbox/editor-token:ro" \
            {{ _agentbox_editor_image | quote }} \
            sh -c 'umask 007 && exec "$0" "$@"' \
            {{ (_agentbox_editor_server ~ '/bin/code-server') | quote }} \
            --socket-path /run/agentbox/editor/editor.sock \
            --connection-token-file /run/agentbox/editor-token \
            --accept-server-license-terms \
            --disable-telemetry \
            --server-data-dir {{ _agentbox_editor_data | quote }} \
            --extensions-dir {{ _agentbox_editor_extensions | quote }} \
            --default-folder /work \
            >/dev/null; then
        echo "agentbox: editor in $editor_name; from the controller: agentbox-remote --open-editor $project" >&2
    else
        echo "agentbox: the editor did not start; the session goes on without it" >&2
    fi
fi

{% endif %}
permanent_tokens=
session_tokens=
if [ -d "$permdir" ]; then
    permanent_tokens=--volume=$permdir:/run/agentbox/git/permanent:ro
    for f in "$permdir"/*; do
        if [ -f "$f" ]; then echo "agentbox: repository token for ${f##*/} (permanent)" >&2; fi
    done
fi
if [ -d "$sessdir" ]; then
    rundir={{ _agentbox_session_token_dir | quote }}/.run-$project-$$
    mv "$sessdir" "$rundir"
    session_tokens=--volume=$rundir:/run/agentbox/git/session:ro
    for f in "$rundir"/*; do
        if [ -f "$f" ]; then echo "agentbox: repository token for ${f##*/} (session, deleted when it ends)" >&2; fi
    done
fi

{% if agentbox_peer_links %}
peer_socket=
peer_config=
if [ -n "$linked" ]; then
    [ -S {{ agentbox_peer_run_dir | quote }}/"$project"/peer.sock ] \
        || die "the peer broker is not running; see systemctl status agentbox-peer"
    peer_socket=--volume={{ agentbox_peer_run_dir }}/$project:{{ agentbox_peer_socket_target }}
    peer_config=--volume={{ agentbox_peer_mcp_path }}:{{ agentbox_managed_mcp_target }}:ro
    set -- claude --dangerously-load-development-channels server:peer
    echo "agentbox: linked session: sends to ${peers:-nobody}, telemetry on, confirm the channel dialog" >&2
fi

{% endif %}
if [ -t 0 ] && [ -t 1 ]; then
    tty=--tty
else
    tty=
fi

# No exec: the launcher waits, to stop the container on a signal and to
# delete a session token afterwards. Not in the foreground either: the shell
# runs a trap only once a foreground command has returned, and when tmux
# closes a pane, the hangup reaches the launcher, not podman's client, which
# then keeps it waiting (seen 2026-11-15). wait returns at once on a trapped
# signal. A background command gets /dev/null as its stdin, so the client
# gets the launcher's through fd 3.
exec 3<&0
podman run --rm --interactive ${tty:+"$tty"} \
    --name "agentbox-$project" \
{# claude does not reap orphans as PID 1; the zombies of its sandboxed
   commands pile up against the pids limit. catatonit takes PID 1 instead. #}
    --init \
    --pull=never \
    --memory={{ sandbox_memory | quote }} --memory-swap={{ sandbox_memory | quote }} \
    --cpus={{ sandbox_cpus | quote }} \
    --pids-limit={{ sandbox_pids_limit | quote }} \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --userns=keep-id:uid={{ agentbox_image_uid }},gid={{ agentbox_image_uid }} \
    --volume "$workdir:/work" --workdir /work \
    --volume "$statedir:{{ agentbox_claude_config_dir }}" \
    --volume {{ (agentbox_managed_settings_path ~ ':' ~ agentbox_managed_settings_target ~ ':ro') | quote }} \
    ${permanent_tokens:+"$permanent_tokens"} \
    ${session_tokens:+"$session_tokens"} \
{% if agentbox_peer_links %}
    ${peer_socket:+"$peer_socket"} \
    ${peer_config:+"$peer_config"} \
{% endif %}
    --env CLAUDE_CONFIG_DIR={{ agentbox_claude_config_dir | quote }} \
{% for name, value in agentbox_claude_env | dictsort %}
{%   if agentbox_peer_links and name in agentbox_peer_unset_env %}
    ${unlinked:+{{ ('--env=' ~ name ~ '=' ~ value) | quote }}} \
{%   else %}
    --env {{ (name ~ '=' ~ value) | quote }} \
{%   endif %}
{% endfor %}
{% for name, value in agentbox_auto_claude_env | dictsort %}
    ${auto:+{{ ('--env=' ~ name ~ '=' ~ value) | quote }}} \
{% endfor %}
    ${secret:+"$secret"} \
    {{ _agentbox_image | quote }} "$@" 0<&3 3<&- &
podman_pid=$!
exec 3<&-
status=0
wait "$podman_pid" || status=$?
exit "$status"

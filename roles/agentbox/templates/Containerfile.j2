# {{ ansible_managed }}
# The agentbox image. Built rootless as {{ sandbox_user }}; every RUN step gets
# the proxy from containers.conf and none of it is baked into the image, so
# nothing here mentions a proxy.

FROM {{ agentbox_base_image }}

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends {{ agentbox_apt_packages | join(' ') }} \
 && rm -rf /var/lib/apt/lists/*

# NodeSource, as in roles/nodejs. The key is ASCII-armored and apt reads a .asc
# keyring in signed-by directly, so the image needs no gnupg.
RUN install -d -m 0755 /etc/apt/keyrings \
 && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      -o /etc/apt/keyrings/nodesource.asc \
 && echo "deb [signed-by=/etc/apt/keyrings/nodesource.asc] https://deb.nodesource.com/node_{{ agentbox_node_major_version }}.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# Installed as root under /usr, so the session user cannot modify it. Updates
# come from a rebuild, never from Claude Code itself.
RUN npm install -g @anthropic-ai/claude-code@{{ agentbox_claude_code_version }} \
 && npm cache clean --force

ENV DISABLE_AUTOUPDATER=1

# uid and gid pinned: the launcher's keep-id mapping names them.
RUN groupadd --gid {{ agentbox_image_uid }} {{ agentbox_image_user }} \
 && useradd --uid {{ agentbox_image_uid }} --gid {{ agentbox_image_uid }} --create-home --shell /bin/bash {{ agentbox_image_user }} \
 && install -d -o {{ agentbox_image_user }} -g {{ agentbox_image_user }} -m 0755 /work

USER {{ agentbox_image_user }}
WORKDIR /work
CMD ["claude"]

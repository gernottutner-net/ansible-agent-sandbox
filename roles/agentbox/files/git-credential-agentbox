#!/bin/sh
# git-credential-agentbox: answers git inside an agentbox session with the
# project's repository token, if the launcher mounted one. Registered for
# every host in /etc/gitconfig. See docs/design.md, "Repository tokens".
#
# The launcher mounts the project's tokens read-only, one file per host, in
# git's own credential format (username=..., password=...):
#
#   /run/agentbox/git/session/<host>     a session token, deleted after the session
#   /run/agentbox/git/permanent/<host>   a permanent one
#
# A session token wins over a permanent one for the same host.

set -eu

# Only `get` returns anything. `store` and `erase` are deliberate no-ops: git
# calls `store` after every successful authentication, and the tokens are
# written by the git_token playbook alone, read-only here.
[ "${1:-}" = get ] || exit 0

protocol=
host=
while IFS='=' read -r key value; do
    case $key in
        protocol) protocol=$value ;;
        host)     host=$value ;;
        '')       break ;;
    esac
done

# HTTPS only: a token never goes out over plain HTTP. And a host is one file
# name, never a path.
[ "$protocol" = https ] || exit 0
case $host in
    '' | .* | */*) exit 0 ;;
esac

for dir in /run/agentbox/git/session /run/agentbox/git/permanent; do
    if [ -r "$dir/$host" ]; then
        cat "$dir/$host"
        exit 0
    fi
done
exit 0
